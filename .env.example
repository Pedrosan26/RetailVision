# Database credentials. Compose creates the database with these on first
# run and builds the server's DATABASE_URL from the same values.
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retailvision

# Per-camera-node API keys the server accepts on /api/v1/ingest, as
# "node-id:key" pairs separated by commas. Each node passes its own with
# --camera-node-id and --api-key. Use real random values, not these.
CAMERA_NODE_API_KEYS=camera-01:change-me,camera-02:change-me
